# Application
NODE_ENV=development
PORT=4000
APP_BASE_URL=http://localhost:5173
API_BASE_URL=http://localhost:4000

# Dashboard (Vite) — set in Vercel Project → Environment Variables for production
# VITE_API_BASE_URL=https://api.yourdomain.com

# MySQL / MariaDB
DATABASE_HOST=auth-db1022.hstgr.io
DATABASE_PORT=3306
DATABASE_NAME=u318374879_test2_coupon
DATABASE_USER=u318374879_test2_coupon
DATABASE_PASSWORD=test2_coupon_userDB

# Auth / session
JWT_SECRET=change-me-to-a-long-random-string
SESSION_SECRET=change-me-to-another-long-random-string

# AES-256-GCM key: 32 bytes as hex (64 hex chars) or base64
ENCRYPTION_KEY=

# Cloudinary unsigned upload (no API key/secret)
# Uses: POST https://api.cloudinary.com/v1_1/{cloud_name}/image/upload
# Delivery: https://res.cloudinary.com/{cloud_name}/image/upload/{public_id}.jpg
CLOUDINARY_CLOUD_NAME=dyb3jipsi
CLOUDINARY_UPLOAD_PRESET=cooking

# Instagram / Meta (server-only)
INSTAGRAM_CLIENT_ID=
INSTAGRAM_CLIENT_SECRET=
INSTAGRAM_REDIRECT_URI=http://localhost:4000/api/accounts/instagram/callback

# Cookie / CORS
COOKIE_SECURE=false
CORS_ORIGIN=http://localhost:5173

# Defaults
DEFAULT_TIMEZONE=Asia/Kolkata

# MCP / ChatGPT (optional extras)
# Comma-separated browser origins allowed to call /mcp in production (in addition to OpenAI)
MCP_CORS_ORIGINS=
# Only for non-localhost HTTP issuer URLs during development tunnels
# MCP_DANGEROUSLY_ALLOW_INSECURE_ISSUER_URL=true
